# Required for Ethereum tracing (free key: https://etherscan.io/apis). Bitcoin needs no key.
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional: point Bitcoin lookups at your own Esplora / electrs instance
# (defaults to blockstream.info, falling back to mempool.space)
# ESPLORA_URL=https://mempool.space/api

# Optional: Ethereum JSON-RPC used for ENS names (defaults to a public node)
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional: Etherscan calls per second (free tier ≈ 3). Raise it if you upgrade your plan.
# ETHERSCAN_RPS=3
# Public name tags need Etherscan's Pro Plus plan; set to 0 to never try
# ETHERSCAN_NAMETAGS=0

# Optional: Tron works without a key, but TronGrid's free key (trongrid.io) raises the rate limit a lot
# TRONGRID_API_KEY=

# Optional: Tronscan names Tron addresses (exchange hot wallets, flagged scams). Works without a
# key at a lower rate limit; free key at tronscan.org → API Keys. Tracing itself uses TronGrid above.
# TRONSCAN_API_KEY=
