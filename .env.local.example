# Required for Ethereum tracing (free key: https://etherscan.io/apis). Bitcoin needs no key.
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional: point Bitcoin lookups at your own Esplora / electrs instance
# (defaults to blockstream.info, falling back to mempool.space)
# ESPLORA_URL=https://mempool.space/api

# Optional: Ethereum JSON-RPC used for ENS names (defaults to a public node)
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional: Etherscan calls per second (free tier ≈ 3). Raise it if you upgrade your plan.
# ETHERSCAN_RPS=3
# Public name tags need Etherscan's Pro Plus plan; set to 0 to never try
# ETHERSCAN_NAMETAGS=0

# Optional: Tron works without a key, but TronGrid's free key (trongrid.io) raises the rate limit a lot
# TRONGRID_API_KEY=

# Optional: Tronscan names Tron addresses (exchange hot wallets, flagged scams). Works without a
# key at a lower rate limit; free key at tronscan.org → API Keys. Tracing itself uses TronGrid above.
# TRONSCAN_API_KEY=

# ── Accounts (sign in with a wallet or email; cases saved to your account) ──
# Reown (WalletConnect) project ID: free at https://cloud.reown.com. Add your site's
# domains (and localhost) to the project's allowlist.
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Your site's public URL (shown in the wallet's sign-in prompt)
# NEXT_PUBLIC_SITE_URL=https://ashiato-six.vercel.app
# 32+ random characters used to sign session cookies: e.g. `openssl rand -hex 32`
AUTH_SECRET=
# Supabase project: Project URL (https://<ref>.supabase.co) from Project Settings → Data API; the
# secret key (sb_secret_…) or legacy service_role key from API Keys. Run supabase/cases.sql once.
# The service role key is secret: server only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: where the ScamSniffer phishing/drainer list is downloaded from (GPL-3.0, not bundled)
# SCAMSNIFFER_URL=https://raw.githubusercontent.com/scamsniffer/scam-database/main/blacklist/address.json
