# Required for Ethereum tracing (free key: https://etherscan.io/apis). Bitcoin needs no key.
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Optional: point Bitcoin lookups at your own Esplora / electrs instance
# (defaults to blockstream.info, falling back to mempool.space)
# ESPLORA_URL=https://mempool.space/api
